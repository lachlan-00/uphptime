{
    "schema_version": 1,
    "data_dir": "data",
    "check_interval_seconds": 300,
    "retention_days": 90,
    "request_timeout_seconds": 10,
    "run_budget_seconds": 240,
    "stale_after_seconds": 900,
    "http_user_agent": "",
    "timezone": "UTC",
    "pinger_enabled": true,
    "clock_skew_seconds": 60,
    "default_peer_rate_limit_per_minute": 60,
    "peer_request_timeout_seconds": 10,
    "pinger_max_timeout_seconds": 15,
    "max_redirects": 0,
    "response_size_cap_bytes": 2097152,
    "tcp_port_allowlist": [21, 22, 25, 53, 80, 110, 143, 443, 465, 587, 993, 995, 3306, 5432, 6379, 8080, 8443],
    "egress_allowed_ranges": [],
    "pinger_cache_enabled": true,
    "pinger_cache_ttl_seconds": 60,
    "pinger_cache_refresh_lead_seconds": 10,
    "pinger_cache_idle_eviction_seconds": 3600,
    "pinger_cache_max_tracked_targets": 500,
    "max_delegates_per_acquisition": 3,
    "canary_sample_rate": 0.07,
    "challenge_token_ttl_seconds": 300,
    "report_api_key": "",
    "report_cors_allowed_origin": "*",
    "peer_reputation_neutral_score": 100.0,
    "peer_reputation_ewma_alpha": 0.2,
    "peer_reputation_disagreement_alpha": 0.35,
    "peer_reputation_confirmation_disagreement_alpha": 0.1,
    "peer_reputation_false_pass_alpha": 0.5,
    "peer_reputation_exclusion_threshold": 40.0,
    "peer_reputation_cooldown_seconds": 3600,
    "peer_reputation_cooldown_backoff_multiplier": 2.0,
    "peer_reputation_max_cooldown_seconds": 86400,
    "peer_reputation_probation_score": 45.0,
    "storage_backend": "json",
    "sql_host": "127.0.0.1",
    "sql_port": 0,
    "sql_database": "uphptime",
    "sql_username": "",
    "sql_password": ""
}
