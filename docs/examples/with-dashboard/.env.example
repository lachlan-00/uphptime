# Copy to .env (alongside this file) to override. Unset variables fall back to the defaults below.

# The port Apache (primary node) and nginx (dashboard) listen on, and the host ports published for them.
#UPHPTIME_HTTP_PORT=48488
#DASHBOARD_HTTP_PORT=48480

# Set these to your host user's id/group if you want to edit files under ./data directly without
# sudo. Named PUID/PGID, not UID/GID - see ../.env.example for why.
#PUID=1000
#PGID=1000

# HTTPS for primary, directly - no reverse proxy - see ../.env.example and the main README's "HTTPS,
# directly" section for full detail. Drop your cert/key at ./data/primary/config/ssl/ (default filenames
# need no env vars) and uncomment the 443 port line above for primary; point these at your own filenames
# instead if they're named differently (e.g. a .key extension) - nothing needs renaming to fit:
#UPHPTIME_HTTPS_PORT=443
#UPHPTIME_TLS_CERT_FILE=/var/www/html/config/ssl/mycert.pem
#UPHPTIME_TLS_KEY_FILE=/var/www/html/config/ssl/mykey.key
#UPHPTIME_TLS_CHAIN_FILE=/var/www/html/config/ssl/intermediate.pem
