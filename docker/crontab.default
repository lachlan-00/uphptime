PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

*/5 * * * * root su -s /bin/sh -c 'php /var/www/html/bin/uphptime check:run' www-data >> /proc/1/fd/1 2>> /proc/1/fd/2
* * * * * root su -s /bin/sh -c 'php /var/www/html/bin/uphptime pinger:refresh-cache' www-data >> /proc/1/fd/1 2>> /proc/1/fd/2
2 1 * * * root su -s /bin/sh -c 'php /var/www/html/bin/uphptime storage:export --dir="/var/www/html/backup/$(date -u +%Y%m%dT%H%M%SZ)"' www-data >> /proc/1/fd/1 2>> /proc/1/fd/2
